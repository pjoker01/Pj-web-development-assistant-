# Same LiveKit project as the PJ assistant web app (or your self-hosted LiveKit server).
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=pj-assistant

# PJ remains the only LLM/business brain. Do not put Gemini/OpenAI keys here.
PJ_ASSISTANT_CHAT_URL=https://chat.pjwebdev.online/api/pj-assistant/chat

# Self-hostable OpenAI-compatible speech services.
PJ_STT_BASE_URL=http://faster-whisper:8000/v1
PJ_STT_API_KEY=not-needed
PJ_STT_MODEL=whisper-1

PJ_TTS_BASE_URL=http://kokoro:8880/v1
PJ_TTS_API_KEY=not-needed
PJ_TTS_MODEL=kokoro
PJ_TTS_VOICE=am_michael

LOG_LEVEL=INFO
